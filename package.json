{
  "name": "hookline",
  "version": "1.0.1",
  "private": true,
  "description": "Catch every webhook. Replay anything. Pipe it to localhost.",
  "license": "GPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.3"
  },
  "workspaces": [
    "apps/web",
    "packages/db",
    "packages/shared",
    "services/edge",
    "services/worker",
    "cli",
    "packages/gocommon",
    "packages/protocol"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome lint . && turbo run lint",
    "typecheck": "tsc -p scripts --noEmit && turbo run typecheck",
    "test": "bun test scripts && turbo run test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "format": "biome format --write .",
    "check": "biome check . && tsc -p scripts --noEmit && bun test scripts && turbo run typecheck lint test",
    "check:fix": "biome check --write .",
    "gen": "bun scripts/gen.ts",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun packages/db/scripts/migrate.ts",
    "db:seed": "bun packages/db/scripts/seed.ts",
    "db:studio": "bun run --cwd packages/db db:studio",
    "admin:grant": "bun packages/db/scripts/admin-grant.ts",
    "loadtest": "bun scripts/loadtest.ts",
    "vulncheck": "turbo run vulncheck && bun audit --audit-level=high",
    "setup:go": "bun scripts/go.ts setup"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "openapi-typescript": "7.13.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
