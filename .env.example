# Copy to .env. In development every service reads this one file:
# Next.js through next.config.ts, the Go services through scripts/go.ts,
# and docker compose for the host ports below.

# Public URL of the web app. Never hard-code hosts; everything derives from env.
APP_URL=http://localhost:3000
# Where the web app reaches the edge server.
EDGE_INTERNAL_URL=http://localhost:8080

# Go services
EDGE_ADDR=:8080
WORKER_HEALTH_ADDR=:8081
LOG_LEVEL=info
LOG_FORMAT=text  # json in production

# Host ports for docker compose (defaults avoid 5432/6379 clashes)
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Infrastructure, matching docker-compose.yml
DATABASE_URL=postgres://hookline:hookline@localhost:5433/hookline?sslmode=disable
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hookline-payloads
S3_ACCESS_KEY_ID=hookline
S3_SECRET_ACCESS_KEY=hookline-dev-secret
S3_FORCE_PATH_STYLE=true
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Hookline <no-reply@hookline.localhost>"

# Optional
# SEED_PASSWORD=hookline-dev-password   # password for the seeded accounts
# TEST_DATABASE_URL=postgres://hookline:hookline@localhost:5433/postgres  # Go DB tests reuse this server instead of testcontainers
