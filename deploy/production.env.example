# Production settings for docker-compose.prod.yml.
#
#   cp deploy/production.env.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Generate every secret with: openssl rand -base64 48
# Connection URLs between the containers are set in docker-compose.prod.yml.

# The domain Hookline is served on (DNS must point at this host) and the
# address Let's Encrypt writes to about the certificate.
HOOKLINE_DOMAIN=hookline.example.com
ACME_EMAIL=ops@example.com

# Image tag to run (a release such as 0.1.0, or latest).
HOOKLINE_VERSION=latest

# Secrets. Never reuse the development values.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
STREAM_TOKEN_SECRET=
# kid:base64(32 random bytes); add new keys in front to rotate:
#   echo "k1:$(openssl rand -base64 32)"
DATA_ENCRYPTION_KEY=
# Object storage (bundled MinIO). Use a long random secret.
S3_ACCESS_KEY_ID=hookline
S3_SECRET_ACCESS_KEY=
S3_BUCKET=hookline-payloads

# Email (verification, password resets, invitations, notifications).
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="Hookline <no-reply@hookline.example.com>"

# "unlimited" lifts every plan limit (usual for private instances).
PLAN_OVERRIDE=

# Stripe billing; leave empty to keep billing off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Daily database backups kept in the backups volume.
BACKUP_KEEP_DAYS=14

LOG_LEVEL=info
