{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "apps/web/**",
      "packages/shared/**",
      "packages/db/src/**",
      "config/**",
      "api/**",
      "bun.lock",
      "package.json",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/readyz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 15
  }
}
