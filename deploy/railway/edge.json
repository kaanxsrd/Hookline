{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "services/edge/**",
      "packages/gocommon/**",
      "packages/protocol/**",
      "go.work",
      "go.work.sum",
      "Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
